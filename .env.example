# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# vlrggapi base URL — self-host locally (see README) since the public instance is down
VLR_API_BASE=http://127.0.0.1:3001

# How often to check for new data (seconds)
NEWS_POLL_INTERVAL=3600
LIVE_POLL_INTERVAL=80
UPCOMING_POLL_INTERVAL=7200
RESULTS_POLL_INTERVAL=21600
